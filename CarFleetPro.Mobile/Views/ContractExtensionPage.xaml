<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:CarFleetPro.Mobile.Models"
             x:Class="CarFleetPro.Mobile.Views.ContractExtensionPage"
             BackgroundColor="{AppThemeBinding Light=#F3F4F6, Dark=#0F172A}"
             Shell.NavBarIsVisible="False"
             x:DataType="models:Vehicle">

    <Grid RowDefinitions="Auto, *">

        <!-- ══════════════════ HEADER ══════════════════ -->
        <Border Grid.Row="0" BackgroundColor="#0A1128" StrokeThickness="0" Padding="0,0,0,20">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="0,0,28,28"/>
            </Border.StrokeShape>
            <Grid RowDefinitions="75, Auto, Auto">

                <!-- Top Nav Bar -->
                <Grid Grid.Row="0" Padding="20,10,20,0">
                    <ImageButton Source="arrow_back_white.svg"
                                 Clicked="OnBackClicked"
                                 BackgroundColor="Transparent"
                                 WidthRequest="30" HeightRequest="30"
                                 HorizontalOptions="Start" VerticalOptions="Center"/>
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="3">
                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="0">
                            <Label Text="CARFLEET" FontSize="13" TextColor="White" FontAttributes="Bold"/>
                            <Label Text="PRO"      FontSize="13" TextColor="#3B82F6" FontAttributes="Bold"/>
                        </HorizontalStackLayout>
                        <Label Text="SÖZLEŞME UZATMA" FontSize="18" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Grid>

                <!-- Araç Bilgi Kartı -->
                <Border Grid.Row="1" Margin="20,8,20,0"
                        BackgroundColor="#1E2A4A" StrokeThickness="0" Padding="14,10">
                    <Border.StrokeShape><RoundRectangle CornerRadius="14"/></Border.StrokeShape>
                    <Grid ColumnDefinitions="50, *" ColumnSpacing="12">
                        <!-- Mini Fotoğraf -->
                        <Border Grid.Column="0" WidthRequest="46" HeightRequest="46" StrokeThickness="0"
                                BackgroundColor="#0A1128">
                            <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                            <Grid>
                                <Image Source="{AppThemeBinding Light=car.svg, Dark=carnegatif.svg}"
                                       HeightRequest="26" WidthRequest="26"
                                       HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Grid>
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label Text="{Binding DisplayName}"
                                   TextColor="White" FontSize="15" FontAttributes="Bold"/>
                            <Label Text="{Binding KiralayanKisi, StringFormat='Aktif Müşteri: {0}'}"
                                   TextColor="#10B981" FontSize="12" FontAttributes="Bold"/>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Durum Bilgisi -->
                <Grid Grid.Row="2" Margin="20,10,20,0" ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Border Grid.Column="0" BackgroundColor="#1E2A4A" Padding="8,6" StrokeThickness="0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                        <VerticalStackLayout Spacing="1" HorizontalOptions="Center">
                            <Label Text="{Binding KiralamaSuresi}" FontSize="13" FontAttributes="Bold"
                                   TextColor="White" HorizontalOptions="Center"/>
                            <Label Text="MEVCUT BİTİŞ" FontSize="9" TextColor="#94A3B8" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" BackgroundColor="#1E2A4A" Padding="8,6" StrokeThickness="0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                        <VerticalStackLayout Spacing="1" HorizontalOptions="Center">
                            <Label Text="{Binding MaksimumUzatilabilirGunSayisi, StringFormat='{0} Gün'}" FontSize="13" FontAttributes="Bold"
                                   TextColor="#10B981" HorizontalOptions="Center">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding MaksimumUzatilabilirGunSayisi}" Value="999">
                                        <Setter Property="Text" Value="Sınırsız"/>
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                            <Label Text="MAX UZATMA LİMİTİ" FontSize="9" TextColor="#94A3B8" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

            </Grid>
        </Border>

        <!-- ══════════════════ ANA İÇERİK ══════════════════ -->
        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="20" Spacing="18">

                <!-- Bilgi Notu / Banner -->
                <Border StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=#ECFDF5, Dark=#064E3B}" Padding="14,12">
                    <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                        <Label Text="✨" FontSize="16" VerticalOptions="Center"/>
                        <Label Text="Mevcut müşteri sözleşmesini istediği kadar uzatabilir. Ancak ileri tarihli rezervasyon varsa o rezervasyon tarihine göre limit kısıtlanır." 
                               FontSize="11" FontAttributes="Bold" LineBreakMode="WordWrap" WidthRequest="280"
                               TextColor="{AppThemeBinding Light=#047857, Dark=#A7F3D0}" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>

                <!-- Uzatılacak Gün Girişi -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Kaç Gün Uzatmak İstersiniz? *" FontSize="13" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#374151, Dark=#CBD5E1}"/>
                    <Border HeightRequest="52" Padding="15,0" StrokeThickness="1"
                            Stroke="{AppThemeBinding Light=#10B981, Dark=#059669}"
                            BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                        <Grid ColumnDefinitions="*, Auto">
                            <Entry Grid.Column="0"
                                   Text="{Binding UzatSecilenGunMetni, Mode=TwoWay}"
                                   Keyboard="Numeric"
                                   Placeholder="Gün sayısı yazın (Örn: 5)"
                                   TextColor="{AppThemeBinding Light=#1F2937, Dark=#F1F5F9}"
                                   PlaceholderColor="{AppThemeBinding Light=#9CA3AF, Dark=#64748B}"
                                   VerticalOptions="Center"/>
                            <Label Grid.Column="1" Text="GÜN" FontAttributes="Bold" TextColor="#10B981" 
                                   VerticalOptions="Center" Margin="0,0,5,0" FontSize="12"/>
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- Karşılaştırma & Özet Bilgi Kartı -->
                <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}" StrokeThickness="0" Padding="16,14">
                    <Border.StrokeShape><RoundRectangle CornerRadius="14"/></Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,2" Radius="4" Opacity="0.05"/>
                    </Border.Shadow>
                    
                    <VerticalStackLayout Spacing="12">
                        <Label Text="SÖZLEŞME YENİLEME ÖZETİ" FontSize="10" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" CharacterSpacing="0.5"/>
                        
                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#F1F5F9, Dark=#2D3748}"/>

                        <Grid ColumnDefinitions="*, *">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="MEVCUT BİTİŞ" FontSize="9" TextColor="#94A3B8"/>
                                <Label Text="{Binding KiralamaSuresi}" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1F2937, Dark=#F8FAFC}"/>
                            </VerticalStackLayout>
                            
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="YENİ GÜN SAYISI" FontSize="9" TextColor="#94A3B8"/>
                                <Label Text="{Binding UzatSecilenGunMetni, StringFormat='+ {0} Gün'}" FontSize="13" FontAttributes="Bold" TextColor="#10B981"/>
                            </VerticalStackLayout>
                        </Grid>

                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#F1F5F9, Dark=#2D3748}"/>

                        <VerticalStackLayout Spacing="2">
                            <Label Text="YENİ SÖZLEŞME BİTİŞ TARİHİ" FontSize="9" TextColor="#94A3B8"/>
                            <Label x:Name="YeniBitisTarihiLabel" Text="-" FontSize="15" FontAttributes="Bold" TextColor="#EF4444"/>
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Border>

                <!-- Onayla Butonu -->
                <Button Text="🕒 SÖZLEŞMEYİ UZAT VE ONAYLA"
                        Clicked="OnUzatOnaylaClicked"
                        BackgroundColor="#10B981"
                        TextColor="White"
                        FontAttributes="Bold"
                        FontSize="14"
                        HeightRequest="52"
                        CornerRadius="12"
                        Margin="0,10,0,0"/>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
