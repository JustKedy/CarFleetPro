<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:CarFleetPro.Mobile.Models"
             x:Class="CarFleetPro.Mobile.Views.AddReservationPage"
             BackgroundColor="{AppThemeBinding Light=#F3F4F6, Dark=#0F172A}"
             Shell.NavBarIsVisible="False"
             x:DataType="models:Vehicle">

    <Grid RowDefinitions="Auto, *">

        <!-- ══════════════════ HEADER ══════════════════ -->
        <Border Grid.Row="0" BackgroundColor="#0A1128" StrokeThickness="0" Padding="0,0,0,20">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="0,0,28,28"/>
            </Border.StrokeShape>
            <Grid RowDefinitions="75, Auto, Auto">

                <!-- Top Nav Bar -->
                <Grid Grid.Row="0" Padding="20,10,20,0">
                    <ImageButton Source="arrow_back_white.svg"
                                 Clicked="OnBackClicked"
                                 BackgroundColor="Transparent"
                                 WidthRequest="30" HeightRequest="30"
                                 HorizontalOptions="Start" VerticalOptions="Center"/>
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="3">
                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="0">
                            <Label Text="CARFLEET" FontSize="13" TextColor="White" FontAttributes="Bold"/>
                            <Label Text="PRO"      FontSize="13" TextColor="#3B82F6" FontAttributes="Bold"/>
                        </HorizontalStackLayout>
                        <Label Text="REZERVASYON EKLE" FontSize="18" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Grid>

                <!-- Araç Bilgi Kartı -->
                <Border Grid.Row="1" Margin="20,8,20,0"
                        BackgroundColor="#1E2A4A" StrokeThickness="0" Padding="14,10">
                    <Border.StrokeShape><RoundRectangle CornerRadius="14"/></Border.StrokeShape>
                    <Grid ColumnDefinitions="50, *" ColumnSpacing="12">
                        <!-- Mini Fotoğraf -->
                        <Border Grid.Column="0" WidthRequest="46" HeightRequest="46" StrokeThickness="0"
                                BackgroundColor="#0A1128">
                            <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                            <Grid>
                                <Image Source="{AppThemeBinding Light=car.svg, Dark=carnegatif.svg}"
                                       HeightRequest="26" WidthRequest="26"
                                       HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Grid>
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label Text="{Binding DisplayName}"
                                   TextColor="White" FontSize="15" FontAttributes="Bold"/>
                            <Label Text="Durum: Kirada (Dolu)"
                                   TextColor="#EF4444" FontSize="12" FontAttributes="Bold"/>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Rezervasyon Kuralları Özeti -->
                <Grid Grid.Row="2" Margin="20,10,20,0" ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Border Grid.Column="0" BackgroundColor="#1E2A4A" Padding="8,6" StrokeThickness="0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                        <VerticalStackLayout Spacing="1" HorizontalOptions="Center">
                            <Label Text="{Binding KiralamaSuresi}" FontSize="13" FontAttributes="Bold"
                                   TextColor="White" HorizontalOptions="Center"/>
                            <Label Text="MEVCUT BİTİŞ" FontSize="9" TextColor="#94A3B8" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" BackgroundColor="#1E2A4A" Padding="8,6" StrokeThickness="0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                        <VerticalStackLayout Spacing="1" HorizontalOptions="Center">
                            <Label x:Name="MinTarihLabel" Text="-" FontSize="12" FontAttributes="Bold"
                                   TextColor="#6366F1" HorizontalOptions="Center"/>
                            <Label Text="EN ERKEN RANDEVU" FontSize="9" TextColor="#94A3B8" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

            </Grid>
        </Border>

        <!-- ══════════════════ ANA İÇERİK ══════════════════ -->
        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="20" Spacing="18">

                <!-- Bilgi Notu / Banner -->
                <Border StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=#EEF2FF, Dark=#1E1B4B}" Padding="14,12">
                    <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                        <Label Text="ℹ️" FontSize="16" VerticalOptions="Center"/>
                        <Label Text="5 günlük kiralama koruma (opsiyon) süresi nedeniyle yeni rezervasyonlar en erken kiralama bitişinden 6 gün sonra başlayabilir." 
                               FontSize="11" FontAttributes="Bold" LineBreakMode="WordWrap" WidthRequest="280"
                               TextColor="{AppThemeBinding Light=#4F46E5, Dark=#C7D2FE}" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>

                <!-- Müşteri Adı Soyadı -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Müşteri Adı Soyadı *" FontSize="13" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#374151, Dark=#CBD5E1}"/>
                    <Border HeightRequest="52" Padding="15,0" StrokeThickness="1"
                            Stroke="{AppThemeBinding Light=#D1D5DB, Dark=#334155}"
                            BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                        <Entry Text="{Binding RezMusteriAdi, Mode=TwoWay}" TextTransform="Uppercase"
                               Placeholder="Müşteri Adı Soyadı"
                               TextColor="{AppThemeBinding Light=#1F2937, Dark=#F1F5F9}"
                               PlaceholderColor="{AppThemeBinding Light=#9CA3AF, Dark=#64748B}"
                               VerticalOptions="Center"/>
                    </Border>
                </VerticalStackLayout>

                <!-- Telefon Numarası -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Telefon Numarası *" FontSize="13" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#374151, Dark=#CBD5E1}"/>
                    <Border HeightRequest="52" Padding="15,0" StrokeThickness="1"
                            Stroke="{AppThemeBinding Light=#D1D5DB, Dark=#334155}"
                            BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                        <Entry Text="{Binding RezMusteriTelefon, Mode=TwoWay}"
                               Keyboard="Telephone"
                               Placeholder="Örn: 0555 123 45 67"
                               TextColor="{AppThemeBinding Light=#1F2937, Dark=#F1F5F9}"
                               PlaceholderColor="{AppThemeBinding Light=#9CA3AF, Dark=#64748B}"
                               VerticalOptions="Center"/>
                    </Border>
                </VerticalStackLayout>

                <!-- Başlangıç Tarihi & Süre -->
                <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                    <!-- Başlangıç Tarihi -->
                    <VerticalStackLayout Grid.Column="0" Spacing="8">
                        <Label Text="Başlangıç Tarihi *" FontSize="13" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#374151, Dark=#CBD5E1}"/>
                        <Border HeightRequest="52" Padding="10,0" StrokeThickness="1"
                                Stroke="{AppThemeBinding Light=#D1D5DB, Dark=#334155}"
                                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}">
                            <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                            <DatePicker x:Name="RezBaslangicDatePicker"
                                        Date="{Binding RezBaslangicTarihi, Mode=TwoWay}"
                                        Format="dd.MM.yyyy"
                                        TextColor="{AppThemeBinding Light=#1F2937, Dark=#F1F5F9}"
                                        VerticalOptions="Center"/>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Kiralama Süresi -->
                    <VerticalStackLayout Grid.Column="1" Spacing="8">
                        <Label Text="Süre (Gün) *" FontSize="13" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#374151, Dark=#CBD5E1}"/>
                        <Border HeightRequest="52" Padding="15,0" StrokeThickness="1"
                                Stroke="{AppThemeBinding Light=#D1D5DB, Dark=#334155}"
                                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}">
                            <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                            <Grid ColumnDefinitions="*, Auto">
                                <Entry Grid.Column="0"
                                       Text="{Binding RezGunSuresi, Mode=TwoWay}"
                                       Keyboard="Numeric"
                                       Placeholder="Gün sayısı"
                                       HorizontalTextAlignment="Center"
                                       TextColor="{AppThemeBinding Light=#1F2937, Dark=#F1F5F9}"
                                       PlaceholderColor="{AppThemeBinding Light=#9CA3AF, Dark=#64748B}"
                                       VerticalOptions="Center"/>
                                <Label Grid.Column="1" Text="GÜN" FontAttributes="Bold" TextColor="#6366F1" 
                                       VerticalOptions="Center" FontSize="11"/>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </Grid>

                <!-- Onayla Butonu -->
                <Button Text="📅 RANDEVU VE REZERVASYON OLUŞTUR"
                        Clicked="OnRezervasyonOnaylaClicked"
                        BackgroundColor="#6366F1"
                        TextColor="White"
                        FontAttributes="Bold"
                        FontSize="14"
                        HeightRequest="52"
                        CornerRadius="12"
                        Margin="0,10,0,0"/>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
