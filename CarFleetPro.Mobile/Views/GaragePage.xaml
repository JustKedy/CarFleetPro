<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CarFleetPro.Mobile.Controls"
             xmlns:vm="clr-namespace:CarFleetPro.Mobile.ViewModels"
             xmlns:models="clr-namespace:CarFleetPro.Mobile.Models"
             x:DataType="vm:GarageViewModel"
             x:Class="CarFleetPro.Mobile.Views.GaragePage"
             BackgroundColor="{AppThemeBinding Light=#F3F4F6, Dark=#0F172A}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto, *, Auto">

        
        <Border Grid.Row="0" BackgroundColor="#0A1128" StrokeThickness="0" HeightRequest="110">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="0,0,20,20" />
            </Border.StrokeShape>
            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="5">
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="0">
                    <Label Text="CARFLEET" FontSize="14" TextColor="White" FontAttributes="Bold"/>
                    <Label Text="PRO"      FontSize="14" TextColor="#3B82F6" FontAttributes="Bold"/>
                </HorizontalStackLayout>
                <Label Text="GARAJ" FontSize="26" TextColor="White"
                       HorizontalOptions="Center" Margin="0,5,0,0"/>
            </VerticalStackLayout>
        </Border>

        
        <Grid Grid.Row="1" RowDefinitions="Auto, Auto, *">

            <!-- Filter Chips -->
            <ScrollView Grid.Row="0" HorizontalOptions="Fill" Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Padding="20,15,20,5">
                <HorizontalStackLayout Spacing="10">
                    <!-- Tümü -->
                    <Border StrokeThickness="0" HeightRequest="38" Padding="15,0">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsTumuSelected}" Value="True">
                                <Setter Property="BackgroundColor" Value="#3B82F6"/>
                            </DataTrigger>
                            <DataTrigger TargetType="Border" Binding="{Binding IsTumuSelected}" Value="False">
                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#E5E7EB, Dark=#1E293B}"/>
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding FiltreleCommand}" CommandParameter="Tümü"/>
                        </Border.GestureRecognizers>
                        <Border.StrokeShape><RoundRectangle CornerRadius="19"/></Border.StrokeShape>
                        <Label Text="Tümü" VerticalOptions="Center" FontAttributes="Bold" FontSize="13">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsTumuSelected}" Value="True">
                                    <Setter Property="TextColor" Value="White"/>
                                </DataTrigger>
                                <DataTrigger TargetType="Label" Binding="{Binding IsTumuSelected}" Value="False">
                                    <Setter Property="TextColor" Value="{AppThemeBinding Light=#4B5563, Dark=#94A3B8}"/>
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Border>

                    <!-- Müsait -->
                    <Border StrokeThickness="1" Stroke="#10B981" HeightRequest="38" Padding="15,0">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsMusaitSelected}" Value="True">
                                <Setter Property="BackgroundColor" Value="#10B981"/>
                            </DataTrigger>
                            <DataTrigger TargetType="Border" Binding="{Binding IsMusaitSelected}" Value="False">
                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}"/>
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding FiltreleCommand}" CommandParameter="Müsait"/>
                        </Border.GestureRecognizers>
                        <Border.StrokeShape><RoundRectangle CornerRadius="19"/></Border.StrokeShape>
                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                            <Ellipse WidthRequest="8" HeightRequest="8">
                                <Ellipse.Triggers>
                                    <DataTrigger TargetType="Ellipse" Binding="{Binding IsMusaitSelected}" Value="True">
                                        <Setter Property="Fill" Value="White"/>
                                    </DataTrigger>
                                    <DataTrigger TargetType="Ellipse" Binding="{Binding IsMusaitSelected}" Value="False">
                                        <Setter Property="Fill" Value="#10B981"/>
                                    </DataTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                            <Label Text="Müsait" FontSize="13">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsMusaitSelected}" Value="True">
                                        <Setter Property="TextColor" Value="White"/>
                                    </DataTrigger>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsMusaitSelected}" Value="False">
                                        <Setter Property="TextColor" Value="{AppThemeBinding Light=#1F2937, Dark=#F1F5F9}"/>
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </HorizontalStackLayout>
                    </Border>

                    <!-- Dolu -->
                    <Border StrokeThickness="1" Stroke="#EF4444" HeightRequest="38" Padding="15,0">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsDoluSelected}" Value="True">
                                <Setter Property="BackgroundColor" Value="#EF4444"/>
                            </DataTrigger>
                            <DataTrigger TargetType="Border" Binding="{Binding IsDoluSelected}" Value="False">
                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}"/>
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding FiltreleCommand}" CommandParameter="Dolu"/>
                        </Border.GestureRecognizers>
                        <Border.StrokeShape><RoundRectangle CornerRadius="19"/></Border.StrokeShape>
                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                            <Ellipse WidthRequest="8" HeightRequest="8">
                                <Ellipse.Triggers>
                                    <DataTrigger TargetType="Ellipse" Binding="{Binding IsDoluSelected}" Value="True">
                                        <Setter Property="Fill" Value="White"/>
                                    </DataTrigger>
                                    <DataTrigger TargetType="Ellipse" Binding="{Binding IsDoluSelected}" Value="False">
                                        <Setter Property="Fill" Value="#EF4444"/>
                                    </DataTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                            <Label Text="Dolu" FontSize="13">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsDoluSelected}" Value="True">
                                        <Setter Property="TextColor" Value="White"/>
                                    </DataTrigger>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsDoluSelected}" Value="False">
                                        <Setter Property="TextColor" Value="{AppThemeBinding Light=#1F2937, Dark=#F1F5F9}"/>
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </HorizontalStackLayout>
                    </Border>

                    <!-- Bakımda -->
                    <Border StrokeThickness="1" Stroke="#F59E0B" HeightRequest="38" Padding="15,0">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsBakimdaSelected}" Value="True">
                                <Setter Property="BackgroundColor" Value="#F59E0B"/>
                            </DataTrigger>
                            <DataTrigger TargetType="Border" Binding="{Binding IsBakimdaSelected}" Value="False">
                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}"/>
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding FiltreleCommand}" CommandParameter="Bakımda"/>
                        </Border.GestureRecognizers>
                        <Border.StrokeShape><RoundRectangle CornerRadius="19"/></Border.StrokeShape>
                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                            <Ellipse WidthRequest="8" HeightRequest="8">
                                <Ellipse.Triggers>
                                    <DataTrigger TargetType="Ellipse" Binding="{Binding IsBakimdaSelected}" Value="True">
                                        <Setter Property="Fill" Value="White"/>
                                    </DataTrigger>
                                    <DataTrigger TargetType="Ellipse" Binding="{Binding IsBakimdaSelected}" Value="False">
                                        <Setter Property="Fill" Value="#F59E0B"/>
                                    </DataTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                            <Label Text="Bakımda" FontSize="13">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsBakimdaSelected}" Value="True">
                                        <Setter Property="TextColor" Value="White"/>
                                    </DataTrigger>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsBakimdaSelected}" Value="False">
                                        <Setter Property="TextColor" Value="{AppThemeBinding Light=#1F2937, Dark=#F1F5F9}"/>
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </HorizontalStackLayout>
                    </Border>
                </HorizontalStackLayout>
            </ScrollView>

            <!-- Filters UI (Unified Button & Panel) -->
            <VerticalStackLayout Grid.Row="1" Padding="20,0,20,10" Spacing="10" IsVisible="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}">
                
                <!-- Filtrele Butonu -->
                <Button Text="Filtrele" 
                        Command="{Binding ToggleFilterPanelCommand}" 
                        BackgroundColor="#3B82F6" 
                        TextColor="White" 
                        FontAttributes="Bold"
                        CornerRadius="10"
                        HeightRequest="45"/>

                <!-- Açılır Filtre Penceresi -->
                <Border IsVisible="{Binding IsFilterPanelExpanded}" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}" StrokeThickness="1" Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#334155}" Padding="15">
                    <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                    <VerticalStackLayout Spacing="15">
                        
                        <!-- 1. Araç Tipleri -->
                        <VerticalStackLayout Spacing="5">
                            <Label Text="Araç Tipleri" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1F2937, Dark=#F1F5F9}"/>
                            <CollectionView ItemsSource="{Binding SegmentFilters}" SelectionMode="None" MaximumHeightRequest="150">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="models:SegmentFilterItem">
                                        <HorizontalStackLayout Spacing="10" Padding="5,5">
                                            <HorizontalStackLayout.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:GarageViewModel}}, Path=SegmentToggledCommand}" />
                                            </HorizontalStackLayout.GestureRecognizers>
                                            <CheckBox IsChecked="{Binding IsSelected}" Color="#3B82F6" VerticalOptions="Center" CheckedChanged="OnSegmentCheckedChanged" />
                                            <Label Text="{Binding Name}" FontSize="14" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#4B5563, Dark=#CBD5E1}"/>
                                        </HorizontalStackLayout>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>

                        <!-- Ayırıcı Çizgi -->
                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#E5E7EB, Dark=#334155}"/>

                        <!-- 2. Marka Seçimi -->
                        <VerticalStackLayout Spacing="5">
                            <Label Text="Markalar" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1F2937, Dark=#F1F5F9}"/>
                            <CollectionView ItemsSource="{Binding BrandFilters}" SelectionMode="None" MaximumHeightRequest="150">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="models:SegmentFilterItem">
                                        <HorizontalStackLayout Spacing="10" Padding="5,5">
                                            <HorizontalStackLayout.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:GarageViewModel}}, Path=SegmentToggledCommand}" />
                                            </HorizontalStackLayout.GestureRecognizers>
                                            <CheckBox IsChecked="{Binding IsSelected}" Color="#3B82F6" VerticalOptions="Center" CheckedChanged="OnSegmentCheckedChanged" />
                                            <Label Text="{Binding Name}" FontSize="14" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#4B5563, Dark=#CBD5E1}"/>
                                        </HorizontalStackLayout>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                        
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>


            <CollectionView Grid.Row="2"
                Margin="0,10,0,0"
                SelectionMode="None"
                ItemsSource="{Binding AracListesi}"
                IsVisible="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}">

                <CollectionView.Footer>
                    <BoxView HeightRequest="20" BackgroundColor="Transparent"/>
                </CollectionView.Footer>

                <CollectionView.ItemTemplate>
                    
                    <DataTemplate x:DataType="models:Vehicle">
                        <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}"
                                Padding="10" Margin="20,10,20,10"
                                Stroke="Transparent" StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="Black" Offset="0,2" Radius="5" Opacity="0.15"/>
                            </Border.Shadow>

                            <VerticalStackLayout Spacing="10">

                                
                                <Border Padding="0" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=#E5E7EB, Dark=#334155}" HeightRequest="180">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                                    <Image Source="{Binding ResimUrl}"
                                           Aspect="AspectFill"
                                           VerticalOptions="Fill" HorizontalOptions="Fill" />
                                </Border>

                                
                                <Grid ColumnDefinitions="Auto,*,Auto" Padding="5,0" Margin="0,5">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnAracTapped" />
                                    </Grid.GestureRecognizers>

                                    <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                                        <Ellipse WidthRequest="16" HeightRequest="16" VerticalOptions="Center">
                                            <Ellipse.Triggers>
                                                 <DataTrigger TargetType="Ellipse" Binding="{Binding Durum}" Value="MÜSAİT">
                                                     <Setter Property="Fill" Value="#10B981"/>
                                                 </DataTrigger>
                                                 <DataTrigger TargetType="Ellipse" Binding="{Binding Durum}" Value="Müsait">
                                                     <Setter Property="Fill" Value="#10B981"/>
                                                 </DataTrigger>
                                                 <DataTrigger TargetType="Ellipse" Binding="{Binding Durum}" Value="müsait">
                                                     <Setter Property="Fill" Value="#10B981"/>
                                                 </DataTrigger>
                                                 <DataTrigger TargetType="Ellipse" Binding="{Binding Durum}" Value="DOLU">
                                                     <Setter Property="Fill" Value="#EF4444"/>
                                                 </DataTrigger>
                                                 <DataTrigger TargetType="Ellipse" Binding="{Binding Durum}" Value="Dolu">
                                                     <Setter Property="Fill" Value="#EF4444"/>
                                                 </DataTrigger>
                                                 <DataTrigger TargetType="Ellipse" Binding="{Binding Durum}" Value="BAKIMDA">
                                                     <Setter Property="Fill" Value="#F59E0B"/>
                                                 </DataTrigger>
                                                 <DataTrigger TargetType="Ellipse" Binding="{Binding Durum}" Value="Bakımda">
                                                     <Setter Property="Fill" Value="#F59E0B"/>
                                                 </DataTrigger>
                                            </Ellipse.Triggers>
                                        </Ellipse>
                                         <Label Text="{Binding Marka}" TextColor="{AppThemeBinding Light=#1F2937, Dark=#F1F5F9}"
                                                FontSize="16" FontAttributes="Bold" VerticalOptions="Center"/>
                                         <Label Text="{Binding Model}" TextColor="{AppThemeBinding Light=#1F2937, Dark=#F1F5F9}"
                                                FontSize="16" FontAttributes="Bold" VerticalOptions="Center"/>
                                         <Border BackgroundColor="{AppThemeBinding Light=#F3F4F6, Dark=#334155}" StrokeThickness="0" Padding="6,2" Margin="5,0,0,0" VerticalOptions="Center">
                                             <Border.StrokeShape><RoundRectangle CornerRadius="4"/></Border.StrokeShape>
                                             <Label Text="{Binding Plaka}" TextColor="{AppThemeBinding Light=#6B7280, Dark=#94A3B8}"
                                                    FontSize="11" FontAttributes="Bold" VerticalOptions="Center"/>
                                         </Border>
                                    </HorizontalStackLayout>

                                    <Image Grid.Column="2" Source="arrowdown.svg"
                                           HeightRequest="20" WidthRequest="20"
                                           VerticalOptions="Center" HorizontalOptions="End">
                                        <Image.Triggers>
                                            <DataTrigger TargetType="Image" Binding="{Binding IsExpanded}" Value="True">
                                                <Setter Property="Rotation" Value="180"/>
                                            </DataTrigger>
                                        </Image.Triggers>
                                    </Image>
                                </Grid>

                                
                                <Border Padding="20,18" Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#334155}" StrokeThickness="1"
                                        BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#0F172A}"
                                        IsVisible="{Binding IsExpanded}">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="16"/></Border.StrokeShape>
                                    <Border.Shadow>
                                        <Shadow Brush="Black" Offset="0,4" Radius="8" Opacity="0.12"/>
                                    </Border.Shadow>
                                    <VerticalStackLayout Spacing="16">
                                        
                                        <!-- YENİ DURUM BANNER'I (STATUS BANNER) -->
                                        <Border StrokeThickness="0" Padding="14,10" HorizontalOptions="Fill">
                                            <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding Durum}" Value="MÜSAİT">
                                                    <Setter Property="BackgroundColor" Value="#E6F4EA"/>
                                                </DataTrigger>
                                                <DataTrigger TargetType="Border" Binding="{Binding Durum}" Value="Müsait">
                                                    <Setter Property="BackgroundColor" Value="#E6F4EA"/>
                                                </DataTrigger>
                                                <DataTrigger TargetType="Border" Binding="{Binding Durum}" Value="müsait">
                                                    <Setter Property="BackgroundColor" Value="#E6F4EA"/>
                                                </DataTrigger>
                                                <DataTrigger TargetType="Border" Binding="{Binding Durum}" Value="DOLU">
                                                    <Setter Property="BackgroundColor" Value="#FCE8E6"/>
                                                </DataTrigger>
                                                <DataTrigger TargetType="Border" Binding="{Binding Durum}" Value="Dolu">
                                                    <Setter Property="BackgroundColor" Value="#FCE8E6"/>
                                                </DataTrigger>
                                                <DataTrigger TargetType="Border" Binding="{Binding Durum}" Value="BAKIMDA">
                                                    <Setter Property="BackgroundColor" Value="#FEF3D6"/>
                                                </DataTrigger>
                                                <DataTrigger TargetType="Border" Binding="{Binding Durum}" Value="Bakımda">
                                                    <Setter Property="BackgroundColor" Value="#FEF3D6"/>
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Grid ColumnDefinitions="Auto, *">
                                                <Ellipse Grid.Column="0" WidthRequest="10" HeightRequest="10" VerticalOptions="Center" Margin="0,0,8,0">
                                                    <Ellipse.Triggers>
                                                        <DataTrigger TargetType="Ellipse" Binding="{Binding Durum}" Value="MÜSAİT">
                                                            <Setter Property="Fill" Value="#137333"/>
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Ellipse" Binding="{Binding Durum}" Value="Müsait">
                                                            <Setter Property="Fill" Value="#137333"/>
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Ellipse" Binding="{Binding Durum}" Value="müsait">
                                                            <Setter Property="Fill" Value="#137333"/>
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Ellipse" Binding="{Binding Durum}" Value="DOLU">
                                                            <Setter Property="Fill" Value="#C5221F"/>
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Ellipse" Binding="{Binding Durum}" Value="Dolu">
                                                            <Setter Property="Fill" Value="#C5221F"/>
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Ellipse" Binding="{Binding Durum}" Value="BAKIMDA">
                                                            <Setter Property="Fill" Value="#B06000"/>
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Ellipse" Binding="{Binding Durum}" Value="Bakımda">
                                                            <Setter Property="Fill" Value="#B06000"/>
                                                        </DataTrigger>
                                                    </Ellipse.Triggers>
                                                </Ellipse>
                                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                                                    <Label Text="{Binding Durum}" FontSize="12" FontAttributes="Bold" CharacterSpacing="0.8">
                                                        <Label.Triggers>
                                                            <DataTrigger TargetType="Label" Binding="{Binding Durum}" Value="MÜSAİT">
                                                                <Setter Property="TextColor" Value="#137333"/>
                                                                <Setter Property="Text" Value="ARAÇ MÜSAİT"/>
                                                            </DataTrigger>
                                                            <DataTrigger TargetType="Label" Binding="{Binding Durum}" Value="Müsait">
                                                                <Setter Property="TextColor" Value="#137333"/>
                                                                <Setter Property="Text" Value="ARAÇ MÜSAİT"/>
                                                            </DataTrigger>
                                                            <DataTrigger TargetType="Label" Binding="{Binding Durum}" Value="müsait">
                                                                <Setter Property="TextColor" Value="#137333"/>
                                                                <Setter Property="Text" Value="ARAÇ MÜSAİT"/>
                                                            </DataTrigger>
                                                            <DataTrigger TargetType="Label" Binding="{Binding Durum}" Value="DOLU">
                                                                <Setter Property="TextColor" Value="#C5221F"/>
                                                                <Setter Property="Text" Value="ARAÇ KİRALANMIŞ (DOLU)"/>
                                                            </DataTrigger>
                                                            <DataTrigger TargetType="Label" Binding="{Binding Durum}" Value="Dolu">
                                                                <Setter Property="TextColor" Value="#C5221F"/>
                                                                <Setter Property="Text" Value="ARAÇ KİRALANMIŞ (DOLU)"/>
                                                            </DataTrigger>
                                                            <DataTrigger TargetType="Label" Binding="{Binding Durum}" Value="BAKIMDA">
                                                                <Setter Property="TextColor" Value="#B06000"/>
                                                                <Setter Property="Text" Value="ARAÇ BAKIM SÜRECİNDE"/>
                                                            </DataTrigger>
                                                            <DataTrigger TargetType="Label" Binding="{Binding Durum}" Value="Bakımda">
                                                                <Setter Property="TextColor" Value="#B06000"/>
                                                                <Setter Property="Text" Value="ARAÇ BAKIM SÜRECİNDE"/>
                                                            </DataTrigger>
                                                        </Label.Triggers>
                                                    </Label>
                                                    <!-- Rezervasyonlu Alt Bilgisi -->
                                                    <Label Text="Rezervasyonlu" FontSize="10" FontAttributes="Bold" TextColor="#1E3A8A" Margin="0,1,0,0">
                                                        <Label.Triggers>
                                                            <DataTrigger TargetType="Label" Binding="{Binding HasFutureReservation}" Value="False">
                                                                <Setter Property="IsVisible" Value="False"/>
                                                            </DataTrigger>
                                                            <DataTrigger TargetType="Label" Binding="{Binding HasFutureReservation}" Value="True">
                                                                <Setter Property="IsVisible" Value="True"/>
                                                            </DataTrigger>
                                                        </Label.Triggers>
                                                    </Label>
                                                </VerticalStackLayout>
                                            </Grid>
                                        </Border>

                                        <!-- TEKNİK ÖZELLİK ROZETLERİ (CHIPS) -->
                                        <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                                            <!-- Gerçek Plaka Tasarımı -->
                                            <Border Grid.Column="0" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}" Stroke="#3B82F6" StrokeThickness="1" Padding="0" HeightRequest="32" VerticalOptions="Center">
                                                <Border.StrokeShape><RoundRectangle CornerRadius="6"/></Border.StrokeShape>
                                                <Grid ColumnDefinitions="20, *">
                                                    <!-- Sol Mavi TR Şeridi -->
                                                    <Border Grid.Column="0" BackgroundColor="#1E40AF" StrokeThickness="0">
                                                        <Border.StrokeShape><RoundRectangle CornerRadius="4"/></Border.StrokeShape>
                                                        <Label Text="TR" TextColor="White" FontSize="9" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                                                    </Border>
                                                    <!-- Plaka Numarası -->
                                                    <Label Grid.Column="1" Text="{Binding Plaka}" TextColor="{AppThemeBinding Light=#1E2937, Dark=#F8FAFC}" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" CharacterSpacing="0.5"/>
                                                </Grid>
                                            </Border>

                                            <!-- Baz Fiyat Rozeti -->
                                            <Border Grid.Column="1" BackgroundColor="{AppThemeBinding Light=#F1F5F9, Dark=#1E293B}" Stroke="{AppThemeBinding Light=#CBD5E1, Dark=#334155}" StrokeThickness="1" Padding="10,0" HeightRequest="32" VerticalOptions="Center">
                                                <Border.StrokeShape><RoundRectangle CornerRadius="6"/></Border.StrokeShape>
                                                <HorizontalStackLayout Spacing="6" HorizontalOptions="Center" VerticalOptions="Center">
                                                    <Label Text="🏷️" FontSize="11" VerticalOptions="Center"/>
                                                    <Label Text="{Binding BasePrice, StringFormat='{0:N0} ₺/Gün'}" TextColor="{AppThemeBinding Light=#475569, Dark=#94A3B8}" FontSize="12" FontAttributes="Bold" VerticalOptions="Center"/>
                                                </HorizontalStackLayout>
                                            </Border>
                                        </Grid>

                                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#E2E8F0, Dark=#1E293B}" Margin="0,4"/>

                                        <!-- KİRALAMA BİLGİLERİ GRUBU (DİJİTAL SÖZLEŞME ÖZETİ) -->
                                        <VerticalStackLayout Spacing="10">
                                            <VerticalStackLayout.Triggers>
                                                <DataTrigger TargetType="VerticalStackLayout" Binding="{Binding KiralayanKisi}" Value="{x:Null}">
                                                    <Setter Property="IsVisible" Value="False"/>
                                                </DataTrigger>
                                            </VerticalStackLayout.Triggers>

                                            <Label Text="AKTİF SÖZLEŞME ÖZETİ" FontSize="11" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" CharacterSpacing="1"/>

                                            <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}" Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#334155}" StrokeThickness="1" Padding="14,12">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnKiralaClicked"/>
                                                </Border.GestureRecognizers>
                                                <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                                                <Border.Shadow>
                                                    <Shadow Brush="Black" Offset="0,2" Radius="4" Opacity="0.05"/>
                                                </Border.Shadow>
                                                <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto" RowSpacing="6" VerticalOptions="Center">
                                                    <!-- Kiralayan Müşteri (Satır 0, Sütun 0) -->
                                                    <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="2">
                                                        <Label Text="MÜŞTERİ" FontSize="9" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#94A3B8, Dark=#64748B}" CharacterSpacing="0.5"/>
                                                        <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                                            <Label Text="👤" FontSize="12" VerticalOptions="Center"/>
                                                            <Label Text="{Binding KiralayanKisi}" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" LineBreakMode="TailTruncation" VerticalOptions="Center"/>
                                                        </HorizontalStackLayout>
                                                    </VerticalStackLayout>

                                                    <!-- Kiralama Süresi Özeti (Satır 1, Sütun 0) -->
                                                    <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="2">
                                                        <Label Text="KİRALAMA DÖNEMİ" FontSize="9" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#94A3B8, Dark=#64748B}" CharacterSpacing="0.5"/>
                                                        <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                                            <Label Text="📅" FontSize="12" VerticalOptions="Center"/>
                                                            <Label Text="{Binding KiralamaOzetiMetni}" FontSize="11" TextColor="{AppThemeBinding Light=#475569, Dark=#94A3B8}" VerticalOptions="Center"/>
                                                        </HorizontalStackLayout>
                                                    </VerticalStackLayout>

                                                    <!-- Fiyat / Tutar (Satır 0-1, Sütun 1) -->
                                                    <VerticalStackLayout Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" VerticalOptions="Center" HorizontalOptions="End" Spacing="2">
                                                        <Label Text="TOPLAM TUTAR" FontSize="9" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#94A3B8, Dark=#64748B}" CharacterSpacing="0.5" HorizontalOptions="End"/>
                                                        <Label Text="{Binding KiralamaFiyati, StringFormat='{0:N0} ₺'}" FontSize="14" FontAttributes="Bold" TextColor="#10B981" HorizontalOptions="End"/>
                                                    </VerticalStackLayout>
                                                </Grid>
                                            </Border>
                                        </VerticalStackLayout>

                                        <!-- BOŞ ARAÇ BİLGİ ŞERİDİ -->
                                        <Border StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=#EFF6FF, Dark=#172554}" Padding="14,12" HorizontalOptions="Fill" IsVisible="False">
                                            <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding KiralayanKisi}" Value="{x:Null}">
                                                    <Setter Property="IsVisible" Value="True"/>
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                                                <Label Text="✨" FontSize="14" VerticalOptions="Center"/>
                                                <Label Text="Bu araç kiralama veya bakım işlemlerine hazırdır." FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1D4ED8, Dark=#60A5FA}" VerticalOptions="Center"/>
                                            </HorizontalStackLayout>
                                        </Border>

                                        <!-- MODERN BUTON GRUBU -->
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,4,0,0">
                                            <!-- Kirala Butonu -->
                                            <Button Grid.Column="0" Text="🔑 KİRALA" 
                                                    Clicked="OnKiralaClicked"
                                                    BackgroundColor="#2563EB"
                                                    TextColor="White"
                                                    FontSize="13"
                                                    FontAttributes="Bold"
                                                    CornerRadius="12"
                                                    HeightRequest="45"
                                                    CharacterSpacing="0.5">
                                                <Button.Triggers>
                                                    <DataTrigger TargetType="Button" Binding="{Binding Durum}" Value="DOLU">
                                                        <Setter Property="Text" Value="📄 SÖZLEŞME DETAYI"/>
                                                        <Setter Property="BackgroundColor" Value="#1E3A8A"/>
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Button" Binding="{Binding Durum}" Value="Dolu">
                                                        <Setter Property="Text" Value="📄 SÖZLEŞME DETAYI"/>
                                                        <Setter Property="BackgroundColor" Value="#1E3A8A"/>
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Button" Binding="{Binding Durum}" Value="BAKIMDA">
                                                        <Setter Property="Text" Value="🔧 BAKIM DETAYI"/>
                                                        <Setter Property="BackgroundColor" Value="#4B5563"/>
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Button" Binding="{Binding Durum}" Value="Bakımda">
                                                        <Setter Property="Text" Value="🔧 BAKIM DETAYI"/>
                                                        <Setter Property="BackgroundColor" Value="#4B5563"/>
                                                    </DataTrigger>
                                                </Button.Triggers>
                                            </Button>

                                            <!-- Bakım Butonu -->
                                            <Button Grid.Column="1" Text="🛠️ BAKIM" 
                                                    Clicked="OnBakimClicked"
                                                    BackgroundColor="#D97706"
                                                    TextColor="White"
                                                    FontSize="13"
                                                    FontAttributes="Bold"
                                                    CornerRadius="12"
                                                    HeightRequest="45"
                                                    CharacterSpacing="0.5"/>
                                        </Grid>
                                        
                                        <!-- SÖZLEŞME VE REZERVASYON YÖNETİMİ PANELİ (Sadece Kirada İse Görünür) -->
                                        <VerticalStackLayout Spacing="12" Margin="0,12,0,0" IsVisible="True">
                                            <VerticalStackLayout.Triggers>
                                                <DataTrigger TargetType="VerticalStackLayout" Binding="{Binding KiralayanKisi}" Value="{x:Null}">
                                                    <Setter Property="IsVisible" Value="False"/>
                                                </DataTrigger>
                                            </VerticalStackLayout.Triggers>
                                            
                                            <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#E2E8F0, Dark=#334155}" Margin="0,4"/>
                                            
                                            <Label Text="🛡️ SÖZLEŞME VE RANDEVU YÖNETİMİ" FontSize="11" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#475569, Dark=#94A3B8}" CharacterSpacing="0.5" Margin="0,2"/>
                                            
                                            <!-- Panel Butonları -->
                                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                                <!-- Sözleşmeyi Uzat -->
                                                <Button Grid.Column="0" Text="🕒 SÖZLEŞMEYİ UZAT" 
                                                        Clicked="OnUzatSozlesmePanelClicked"
                                                        BackgroundColor="#10B981"
                                                        TextColor="White"
                                                        FontSize="11"
                                                        FontAttributes="Bold"
                                                        CornerRadius="10"
                                                        HeightRequest="40"/>
                                                
                                                <!-- İleri Tarihli Rezervasyon -->
                                                <Button Grid.Column="1" Text="📅 RANDEVU OLUŞTUR" 
                                                        Clicked="OnRezervasyonPanelClicked"
                                                        BackgroundColor="#6366F1"
                                                        TextColor="White"
                                                        FontSize="11"
                                                        FontAttributes="Bold"
                                                        CornerRadius="10"
                                                        HeightRequest="40"/>
                                            </Grid>
                                            
                                            <!-- 3. RANDEVULAR / REZERVASYONLAR ZAMAN TÜNELİ -->
                                            <VerticalStackLayout Spacing="6" Margin="0,4">
                                                <Label Text="🗓️ İLERİ TARİHLİ RANDEVU VE REZERVASYONLAR" FontSize="10" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}"/>
                                                
                                                <!-- Rezervasyon Listesi -->
                                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Rezervasyonlar}">
                                                    <BindableLayout.ItemTemplate>
                                                        <DataTemplate x:DataType="models:RentalInfo">
                                                            <Border StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=#EEF2FF, Dark=#1E1B4B}" Padding="10" Margin="0,2">
                                                                <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                                                                <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10">
                                                                    <Label Grid.Column="0" Text="📅" FontSize="14" VerticalOptions="Center"/>
                                                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                                                        <Label Text="{Binding CustomerName}" FontSize="11" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#312E81, Dark=#E0E7FF}"/>
                                                                        <HorizontalStackLayout Spacing="6">
                                                                            <Label Text="{Binding StartDate, StringFormat='{0:dd.MM.yyyy}'}" FontSize="10" TextColor="{AppThemeBinding Light=#4338CA, Dark=#A5B4FC}"/>
                                                                            <Label Text="-" FontSize="10" TextColor="{AppThemeBinding Light=#4338CA, Dark=#A5B4FC}"/>
                                                                            <Label Text="{Binding PlannedEndDate, StringFormat='{0:dd.MM.yyyy}'}" FontSize="10" TextColor="{AppThemeBinding Light=#4338CA, Dark=#A5B4FC}"/>
                                                                        </HorizontalStackLayout>
                                                                    </VerticalStackLayout>
                                                                    <Border Grid.Column="2" BackgroundColor="#6366F1" Padding="6,3" VerticalOptions="Center">
                                                                        <Border.StrokeShape><RoundRectangle CornerRadius="4"/></Border.StrokeShape>
                                                                        <Label Text="ONAYLANDI" FontSize="9" FontAttributes="Bold" TextColor="White"/>
                                                                    </Border>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </BindableLayout.ItemTemplate>
                                                </VerticalStackLayout>
                                            </VerticalStackLayout>
                                            
                                        </VerticalStackLayout>
                                        
                                    </VerticalStackLayout>
                                </Border>

                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            
            <VerticalStackLayout Grid.Row="2" Padding="20,10,20,20" Spacing="15"
                                 IsVisible="{Binding IsLoading}">

                
                <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}" Padding="14" StrokeThickness="0">
                    <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                    <VerticalStackLayout Spacing="12">
                        <BoxView HeightRequest="150" BackgroundColor="{AppThemeBinding Light=#E5E7EB, Dark=#334155}" CornerRadius="10"/>
                        <BoxView HeightRequest="14" WidthRequest="100" BackgroundColor="#D1D5DB" HorizontalOptions="Start" CornerRadius="6"/>
                        <BoxView HeightRequest="12" WidthRequest="160" BackgroundColor="{AppThemeBinding Light=#E5E7EB, Dark=#334155}" HorizontalOptions="Start" CornerRadius="6"/>
                    </VerticalStackLayout>
                </Border>

                <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}" Padding="14" StrokeThickness="0">
                    <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                    <VerticalStackLayout Spacing="12">
                        <BoxView HeightRequest="150" BackgroundColor="{AppThemeBinding Light=#E5E7EB, Dark=#334155}" CornerRadius="10"/>
                        <BoxView HeightRequest="14" WidthRequest="100" BackgroundColor="#D1D5DB" HorizontalOptions="Start" CornerRadius="6"/>
                        <BoxView HeightRequest="12" WidthRequest="160" BackgroundColor="{AppThemeBinding Light=#E5E7EB, Dark=#334155}" HorizontalOptions="Start" CornerRadius="6"/>
                    </VerticalStackLayout>
                </Border>

                <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}" Padding="14" StrokeThickness="0">
                    <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                    <VerticalStackLayout Spacing="12">
                        <BoxView HeightRequest="150" BackgroundColor="{AppThemeBinding Light=#E5E7EB, Dark=#334155}" CornerRadius="10"/>
                        <BoxView HeightRequest="14" WidthRequest="100" BackgroundColor="#D1D5DB" HorizontalOptions="Start" CornerRadius="6"/>
                        <BoxView HeightRequest="12" WidthRequest="160" BackgroundColor="{AppThemeBinding Light=#E5E7EB, Dark=#334155}" HorizontalOptions="Start" CornerRadius="6"/>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>

        </Grid>

        <controls:BottomNavBar Grid.Row="2" SelectedTab="Garage"/>

    </Grid>
</ContentPage>

