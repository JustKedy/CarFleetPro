<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CarFleetPro.Mobile.Controls"
             xmlns:vm="clr-namespace:CarFleetPro.Mobile.ViewModels"
             xmlns:microcharts="clr-namespace:Microcharts.Maui;assembly=Microcharts.Maui"
             x:DataType="vm:HomeViewModel"
             x:Class="CarFleetPro.Mobile.Views.HomePage"
             BackgroundColor="{AppThemeBinding Light=#F3F4F6, Dark=#0F172A}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="110, *, 75">

        
        <Border Grid.Row="0" BackgroundColor="#0A1128" StrokeThickness="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="0, 0, 20, 20" />
            </Border.StrokeShape>
            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="5">
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="0">
                    <Label Text="CARFLEET" FontSize="14" TextColor="White" FontAttributes="Bold" />
                    <Label Text="PRO"      FontSize="14" TextColor="#3B82F6" FontAttributes="Bold" />
                </HorizontalStackLayout>
                <Label Text="ANA SAYFA" FontSize="24" TextColor="White"
                       HorizontalOptions="Center" Margin="0,5,0,0"/>
            </VerticalStackLayout>
        </Border>

        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
            <Grid>

                
                <VerticalStackLayout Padding="0,10,0,20" Spacing="15"
                                     IsVisible="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}">

                    


                    
                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,*"
                          ColumnSpacing="15" RowSpacing="15" Margin="20,5,20,5">

                        <Border Grid.Row="0" Grid.Column="0" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}" Padding="15" StrokeThickness="0">
                            <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                            <Border.Shadow><Shadow Brush="Black" Offset="0,2" Radius="5" Opacity="0.1"/></Border.Shadow>
                            <VerticalStackLayout>
                                <Label Text="Toplam Araç" FontSize="12" TextColor="{AppThemeBinding Light=#6B7280, Dark=#94A3B8}"/>
                                <Label Text="{Binding ToplamAracSayisi, FallbackValue='45'}"
                                       FontSize="24" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1F2937, Dark=#F1F5F9}" Margin="0,5,0,0"/>
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Row="0" Grid.Column="1" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}" Padding="15" StrokeThickness="0">
                            <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                            <Border.Shadow><Shadow Brush="Black" Offset="0,2" Radius="5" Opacity="0.1"/></Border.Shadow>
                            <VerticalStackLayout>
                                <Label Text="Aktif Kirada" FontSize="12" TextColor="{AppThemeBinding Light=#6B7280, Dark=#94A3B8}"/>
                                <Label Text="{Binding KiradakiAracSayisi, FallbackValue='28'}"
                                       FontSize="24" FontAttributes="Bold" TextColor="#3B82F6" Margin="0,5,0,0"/>
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="0" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}" Padding="15" StrokeThickness="0">
                            <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                            <Border.Shadow><Shadow Brush="Black" Offset="0,2" Radius="5" Opacity="0.1"/></Border.Shadow>
                            <VerticalStackLayout>
                                <Label Text="Müsait Araç" FontSize="12" TextColor="{AppThemeBinding Light=#6B7280, Dark=#94A3B8}"/>
                                <Label Text="{Binding MusaitAracSayisi, FallbackValue='15'}"
                                       FontSize="24" FontAttributes="Bold" TextColor="#10B981" Margin="0,5,0,0"/>
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="1" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}" Padding="15" StrokeThickness="0"
                                IsVisible="{Binding IsAdmin}">
                            <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                            <Border.Shadow><Shadow Brush="Black" Offset="0,2" Radius="5" Opacity="0.1"/></Border.Shadow>
                            <VerticalStackLayout>
                                <Label Text="Aylık Ciro" FontSize="12" TextColor="{AppThemeBinding Light=#6B7280, Dark=#94A3B8}"/>
                                <Label Text="{Binding AylikCiro, StringFormat='{0:N0} ₺', FallbackValue='0 ₺'}"
                                       FontSize="24" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1F2937, Dark=#F1F5F9}" Margin="0,5,0,0"/>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    
                    <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}" Padding="20" Margin="20,5,20,5" StrokeThickness="0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                        <Border.Shadow><Shadow Brush="Black" Offset="0,2" Radius="5" Opacity="0.1"/></Border.Shadow>
                        <VerticalStackLayout Spacing="15">
                            <Label Text="Filo Durum Analizi" FontAttributes="Bold" FontSize="16" TextColor="{AppThemeBinding Light=#1F2937, Dark=#F1F5F9}"/>
                            <microcharts:ChartView Chart="{Binding FiloDurumGrafigi}" HeightRequest="200" BackgroundColor="Transparent"/>
                        </VerticalStackLayout>
                    </Border>

                    
                    <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}" Padding="20" Margin="20,5,20,10" StrokeThickness="0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                        <Border.Shadow><Shadow Brush="Black" Offset="0,2" Radius="5" Opacity="0.1"/></Border.Shadow>
                        <VerticalStackLayout Spacing="15">
                            <Label Text="En Çok Talep Gören Modeller" FontAttributes="Bold" FontSize="16" TextColor="{AppThemeBinding Light=#1F2937, Dark=#F1F5F9}"/>
                            <microcharts:ChartView Chart="{Binding PopulerAracGrafigi}" HeightRequest="200" BackgroundColor="Transparent"/>
                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>

                
                <VerticalStackLayout Padding="20,10,20,20" Spacing="15"
                                     IsVisible="{Binding IsLoading}">

                    
                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,*"
                          ColumnSpacing="15" RowSpacing="15">

                        
                        <Border Grid.Row="0" Grid.Column="0" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}" Padding="15" StrokeThickness="0" HeightRequest="80">
                            <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                            <VerticalStackLayout Spacing="10">
                                <BoxView HeightRequest="12" WidthRequest="80" BackgroundColor="{AppThemeBinding Light=#E5E7EB, Dark=#334155}" HorizontalOptions="Start" CornerRadius="6"/>
                                <BoxView HeightRequest="24" WidthRequest="50" BackgroundColor="#D1D5DB" HorizontalOptions="Start" CornerRadius="6"/>
                            </VerticalStackLayout>
                        </Border>
                        
                        <Border Grid.Row="0" Grid.Column="1" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}" Padding="15" StrokeThickness="0" HeightRequest="80">
                            <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                            <VerticalStackLayout Spacing="10">
                                <BoxView HeightRequest="12" WidthRequest="80" BackgroundColor="{AppThemeBinding Light=#E5E7EB, Dark=#334155}" HorizontalOptions="Start" CornerRadius="6"/>
                                <BoxView HeightRequest="24" WidthRequest="50" BackgroundColor="#D1D5DB" HorizontalOptions="Start" CornerRadius="6"/>
                            </VerticalStackLayout>
                        </Border>
                        
                        <Border Grid.Row="1" Grid.Column="0" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}" Padding="15" StrokeThickness="0" HeightRequest="80">
                            <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                            <VerticalStackLayout Spacing="10">
                                <BoxView HeightRequest="12" WidthRequest="80" BackgroundColor="{AppThemeBinding Light=#E5E7EB, Dark=#334155}" HorizontalOptions="Start" CornerRadius="6"/>
                                <BoxView HeightRequest="24" WidthRequest="50" BackgroundColor="#D1D5DB" HorizontalOptions="Start" CornerRadius="6"/>
                            </VerticalStackLayout>
                        </Border>
                        
                        <Border Grid.Row="1" Grid.Column="1" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}" Padding="15" StrokeThickness="0" HeightRequest="80">
                            <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                            <VerticalStackLayout Spacing="10">
                                <BoxView HeightRequest="12" WidthRequest="80" BackgroundColor="{AppThemeBinding Light=#E5E7EB, Dark=#334155}" HorizontalOptions="Start" CornerRadius="6"/>
                                <BoxView HeightRequest="24" WidthRequest="50" BackgroundColor="#D1D5DB" HorizontalOptions="Start" CornerRadius="6"/>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    
                    <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}" Padding="20" StrokeThickness="0" HeightRequest="120">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                        <VerticalStackLayout Spacing="15">
                            <BoxView HeightRequest="14" WidthRequest="140" BackgroundColor="{AppThemeBinding Light=#E5E7EB, Dark=#334155}" HorizontalOptions="Start" CornerRadius="6"/>
                            <BoxView HeightRequest="12" BackgroundColor="#D1D5DB" CornerRadius="6"/>
                            <BoxView HeightRequest="12" WidthRequest="200" BackgroundColor="{AppThemeBinding Light=#E5E7EB, Dark=#334155}" HorizontalOptions="Center" CornerRadius="6"/>
                        </VerticalStackLayout>
                    </Border>

                    
                    <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}" Padding="20" StrokeThickness="0" HeightRequest="130">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                        <VerticalStackLayout Spacing="18">
                            <BoxView HeightRequest="14" WidthRequest="200" BackgroundColor="{AppThemeBinding Light=#E5E7EB, Dark=#334155}" HorizontalOptions="Start" CornerRadius="6"/>
                            <BoxView HeightRequest="10" BackgroundColor="#D1D5DB" CornerRadius="5"/>
                            <BoxView HeightRequest="10" WidthRequest="220" BackgroundColor="{AppThemeBinding Light=#E5E7EB, Dark=#334155}" HorizontalOptions="Start" CornerRadius="5"/>
                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>

            </Grid>
        </ScrollView>

        <controls:BottomNavBar Grid.Row="2" SelectedTab="Home" />

    </Grid>
</ContentPage>